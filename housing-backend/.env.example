# Copy thành .env rồi sửa
POSTGRES_USER=housing
POSTGRES_PASSWORD=housing
POSTGRES_DB=housing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# App dùng async (asyncpg). Alembic và script import tự đổi sang psycopg.
DATABASE_URL=postgresql+asyncpg://housing:housing@localhost:5432/housing

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Phiên bản nhãn quận mà model đang dùng (district_label.model_version)
DISTRICT_MODEL_VERSION=hcm_24_user_v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024
