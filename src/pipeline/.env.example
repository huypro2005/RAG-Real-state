# Copy thành src/pipeline/.env (không commit). Mật khẩu giống POSTGRES_PASSWORD trong src/web/housing-backend/.env
DATABASE_URL=postgresql://postgres:doi_mat_khau@localhost:5433/housing_dev
# Chỉ cần cho --embed / --embed-only: lấy từ notebook src/notebook/kaggle/embedding_server.ipynb (đổi mỗi phiên Kaggle)
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
# Tùy chọn, chỉ cho giao diện web (python -m src.pipeline.server): bước "Retrain mô hình giá" gọi Prediction Server.
# Khóa phải trùng PREDICTION_SERVER_API_KEY của src/web/prediction_server/.env
PREDICTION_SERVER_URL=http://localhost:8100
PREDICTION_SERVER_API_KEY=
# Giới hạn tổng dung lượng file tải lên mỗi lần chạy (MB), mặc định 100
PIPELINE_MAX_UPLOAD_MB=100
