# Copy thành src/web/housing-backend/.env rồi sửa (không commit).
# Container Postgres (docker compose up -d db) đọc 3 biến POSTGRES_* dưới đây LẦN ĐẦU tạo volume.
# Đổi mật khẩu thì đổi cả trong DATABASE_URL ở đây, src/pipeline/.env và src/web/prediction_server/.env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi_mat_khau
POSTGRES_DB=housing_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# App dùng async (asyncpg). Alembic và script import tự đổi sang psycopg.
DATABASE_URL=postgresql+asyncpg://postgres:doi_mat_khau@localhost:5433/housing_dev

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Phiên bản nhãn quận mà model đang dùng (district_label.model_version)
DISTRICT_MODEL_VERSION=hcm_24_user_v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024

# Khóa dịch vụ ngoài (chỉ backend dùng)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOONG_API_KEY=
# Từ notebook src/notebook/kaggle/embedding_server.ipynb (đổi mỗi phiên Kaggle); trống = xếp theo ngày đăng
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# Prediction Server (khóa trùng với src/web/prediction_server/.env)
PREDICTION_SERVER_URL=http://localhost:8100
PREDICTION_SERVER_API_KEY=
